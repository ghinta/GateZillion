local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GateMath = require(ReplicatedStorage.Shared.domain.GateMath)
local EncounterRules = require(ReplicatedStorage.Shared.domain.EncounterRules)

local MAX = 1000

return function()
	describe("GateMath.apply", function()
		it("adds, subtracts and multiplies", function()
			expect(GateMath.apply("add", 10, 5, MAX)).to.equal(15)
			expect(GateMath.apply("subtract", 3, 5, MAX)).to.equal(2)
			expect(GateMath.apply("multiply", 3, 5, MAX)).to.equal(15)
		end)

		it("clamps negative results to zero", function()
			expect(GateMath.apply("subtract", 10, 5, MAX)).to.equal(0)
			expect(GateMath.apply("subtract", 5, 5, MAX)).to.equal(0)
		end)

		it("clamps overflow to the maximum group size", function()
			expect(GateMath.apply("multiply", 10, 999, MAX)).to.equal(MAX)
			expect(GateMath.apply("add", 1, MAX, MAX)).to.equal(MAX)
		end)

		it("keeps zero at zero for multiplication", function()
			expect(GateMath.apply("multiply", 5, 0, MAX)).to.equal(0)
		end)

		it("rejects non-integer operands and counts", function()
			expect(function()
				GateMath.apply("add", 1.5, 5, MAX)
			end).to.throw("operand")
			expect(function()
				GateMath.apply("add", 0 / 0, 5, MAX)
			end).to.throw("operand")
			expect(function()
				GateMath.apply("add", math.huge, 5, MAX)
			end).to.throw("operand")
			expect(function()
				GateMath.apply("add", 1, 2.5, MAX)
			end).to.throw("count")
		end)

		it("rejects unknown operations", function()
			expect(function()
				GateMath.apply("divide" :: any, 2, 10, MAX)
			end).to.throw("unknown gate op")
		end)
	end)

	describe("GateMath.clamp", function()
		it("floors fractional values and bounds the range", function()
			expect(GateMath.clamp(-4, MAX)).to.equal(0)
			expect(GateMath.clamp(12.7, MAX)).to.equal(12)
			expect(GateMath.clamp(5000, MAX)).to.equal(MAX)
		end)

		it("rejects NaN", function()
			expect(function()
				GateMath.clamp(0 / 0, MAX)
			end).to.throw("NaN")
		end)
	end)

	describe("labels and geometry", function()
		it("labels gates with symbols", function()
			expect(GateMath.label("add", 10)).to.equal("+10")
			expect(GateMath.label("subtract", 5)).to.equal("-5")
			expect(GateMath.label("multiply", 3)).to.equal("×3")
		end)

		it("validates operations", function()
			expect(GateMath.isValidOp("add")).to.equal(true)
			expect(GateMath.isValidOp("divide")).to.equal(false)
			expect(GateMath.isValidOp(nil)).to.equal(false)
		end)

		it("treats the travel segment as half-open (fromZ, toZ]", function()
			expect(GateMath.crossesZ(10, 9, 10)).to.equal(true)
			expect(GateMath.crossesZ(10, 10, 11)).to.equal(false)
			expect(GateMath.crossesZ(10, 8, 9)).to.equal(false)
		end)

		it("treats lanes as half-open [xMin, xMax)", function()
			expect(GateMath.containsX(-12, 0, -12)).to.equal(true)
			expect(GateMath.containsX(-12, 0, 0)).to.equal(false)
			expect(GateMath.containsX(0, 12, 0)).to.equal(true)
		end)

		it("interpolates the lateral position at a row", function()
			expect(GateMath.xAtZ(15, 10, 20, -4, 4)).to.be.near(0)
			expect(GateMath.xAtZ(20, 10, 20, -4, 4)).to.be.near(4)
			expect(GateMath.xAtZ(5, 5, 5, 1, 2)).to.equal(2)
		end)
	end)

	describe("EncounterRules", function()
		it("removes a fixed number of units for obstacles", function()
			expect(EncounterRules.applyObstacle(20, 8, MAX)).to.equal(12)
			expect(EncounterRules.applyObstacle(5, 8, MAX)).to.equal(0)
		end)

		it("trades units one-for-one with enemies", function()
			local survivors, defeated = EncounterRules.applyEnemy(30, 12, MAX)
			expect(survivors).to.equal(18)
			expect(defeated).to.equal(12)
			survivors, defeated = EncounterRules.applyEnemy(10, 12, MAX)
			expect(survivors).to.equal(0)
			expect(defeated).to.equal(10)
		end)
	end)
end
