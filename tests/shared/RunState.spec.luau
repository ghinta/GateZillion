local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunState = require(ReplicatedStorage.Shared.domain.RunState)
local GameConfig = require(ReplicatedStorage.Shared.config.GameConfig)
local Levels = require(ReplicatedStorage.Shared.config.Levels)

local level = Levels.list[1]

return function()
	describe("RunState transitions", function()
		it("follows Lobby -> Loading -> Running -> Completed -> Results -> Lobby", function()
			local run = RunState.new()
			expect(run.phase).to.equal("Lobby")
			RunState.begin(run, 1, level)
			expect(run.phase).to.equal("Loading")
			RunState.transition(run, "Running")
			expect(RunState.finish(run, "Completed", nil)).to.equal(true)
			expect(run.phase).to.equal("Completed")
			RunState.transition(run, "Results")
			RunState.transition(run, "Lobby")
			expect(run.phase).to.equal("Lobby")
		end)

		it("allows Running -> Failed and records the reason", function()
			local run = RunState.new()
			RunState.begin(run, 1, level)
			RunState.transition(run, "Running")
			RunState.finish(run, "Failed", "groupLost")
			expect(run.phase).to.equal("Failed")
			expect(run.failReason).to.equal("groupLost")
		end)

		it("rejects invalid transitions", function()
			local run = RunState.new()
			expect(function()
				RunState.transition(run, "Running")
			end).to.throw("invalid run transition")
			expect(function()
				RunState.transition(run, "Results")
			end).to.throw("invalid run transition")
			expect(RunState.canTransition("Completed", "Running")).to.equal(false)
			expect(RunState.canTransition("Results", "Loading")).to.equal(false)
		end)

		it("finishes a run only once", function()
			local run = RunState.new()
			RunState.begin(run, 1, level)
			RunState.transition(run, "Running")
			expect(RunState.finish(run, "Completed", nil)).to.equal(true)
			expect(RunState.finish(run, "Failed", "late")).to.equal(false)
			expect(run.result).to.equal("Completed")
		end)

		it("resets state when a new attempt begins", function()
			local run = RunState.new()
			RunState.begin(run, 7, level)
			expect(run.runId).to.equal(7)
			expect(run.groupCount).to.equal(level.startCount)
			expect(run.progress).to.equal(0)
			expect(next(run.consumed)).to.equal(nil)
		end)
	end)

	describe("RunState.advance", function()
		it("moves forward at the configured speed and steers within the lane limit", function()
			local run = RunState.new()
			RunState.begin(run, 1, level)
			RunState.transition(run, "Running")
			RunState.setSteer(run, 1)
			local fromZ, toZ, fromX, toX = RunState.advance(run, 0.5, GameConfig, level.length)
			expect(fromZ).to.equal(0)
			expect(toZ).to.be.near(GameConfig.FORWARD_SPEED * 0.5)
			expect(fromX).to.equal(0)
			expect(toX).to.be.near(GameConfig.STEER_SPEED * 0.5)
			for _ = 1, 60 do
				RunState.advance(run, 0.5, GameConfig, level.length)
			end
			expect(run.laneX).to.be.near(RunState.laneLimit(GameConfig))
			expect(run.progress).to.equal(level.length)
		end)

		it("clamps the steering axis and ignores NaN", function()
			local run = RunState.new()
			RunState.setSteer(run, 5)
			expect(run.steerAxis).to.equal(1)
			RunState.setSteer(run, 0 / 0)
			expect(run.steerAxis).to.equal(1)
			RunState.setSteer(run, -3)
			expect(run.steerAxis).to.equal(-1)
		end)

		it("only advances running runs", function()
			local run = RunState.new()
			expect(function()
				RunState.advance(run, 0.1, GameConfig, level.length)
			end).to.throw("running")
		end)
	end)
end
