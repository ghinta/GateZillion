local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage.Shared.config.GameConfig)
local ProfileData = require(ReplicatedStorage.Shared.domain.ProfileData)
local Rewards = require(ReplicatedStorage.Shared.domain.Rewards)

return function()
	describe("Rewards.applyCompletion", function()
		it("awards points, a first-clear bonus, a best score and the next level", function()
			local profile = ProfileData.default()
			local result = Rewards.applyCompletion(profile, 1, 40, 10, GameConfig)
			expect(result.firstClear).to.equal(true)
			expect(result.newBest).to.equal(true)
			expect(result.earnedPoints).to.equal(40 + GameConfig.FIRST_CLEAR_BONUS)
			expect(result.unlockedLevel).to.equal(2)
			expect(profile.highestUnlockedLevel).to.equal(2)
			expect(profile.bestScores["1"]).to.equal(40)
			expect(profile.earnedPoints).to.equal(40 + GameConfig.FIRST_CLEAR_BONUS)
		end)

		it("gives no bonus or unlock on replays and keeps the better score", function()
			local profile = ProfileData.default()
			Rewards.applyCompletion(profile, 1, 40, 10, GameConfig)
			local replay = Rewards.applyCompletion(profile, 1, 30, 10, GameConfig)
			expect(replay.firstClear).to.equal(false)
			expect(replay.newBest).to.equal(false)
			expect(replay.earnedPoints).to.equal(30)
			expect(replay.unlockedLevel).to.equal(nil)
			expect(replay.bestScore).to.equal(40)
			expect(profile.highestUnlockedLevel).to.equal(2)
		end)

		it("caps points per run and in total", function()
			local profile = ProfileData.default()
			local result = Rewards.applyCompletion(profile, 1, 50000, 10, GameConfig)
			expect(result.earnedPoints).to.equal(GameConfig.MAX_POINTS_PER_RUN + GameConfig.FIRST_CLEAR_BONUS)
			profile.earnedPoints = GameConfig.MAX_TOTAL_POINTS - 1
			Rewards.applyCompletion(profile, 1, 500, 10, GameConfig)
			expect(profile.earnedPoints).to.equal(GameConfig.MAX_TOTAL_POINTS)
		end)

		it("does not unlock beyond the last level", function()
			local profile = ProfileData.default()
			profile.highestUnlockedLevel = 10
			local result = Rewards.applyCompletion(profile, 10, 5, 10, GameConfig)
			expect(result.unlockedLevel).to.equal(nil)
			expect(profile.highestUnlockedLevel).to.equal(10)
		end)

		it("refuses locked levels and empty groups", function()
			local profile = ProfileData.default()
			expect(function()
				Rewards.applyCompletion(profile, 3, 10, 10, GameConfig)
			end).to.throw("locked")
			expect(function()
				Rewards.applyCompletion(profile, 1, 0, 10, GameConfig)
			end).to.throw("positive")
		end)
	end)

	describe("Rewards.starsFor", function()
		it("rates the finish count against the best possible result", function()
			expect(Rewards.starsFor(0, 100, GameConfig)).to.equal(0)
			expect(Rewards.starsFor(10, 100, GameConfig)).to.equal(1)
			expect(Rewards.starsFor(50, 100, GameConfig)).to.equal(2)
			expect(Rewards.starsFor(95, 100, GameConfig)).to.equal(3)
			expect(Rewards.starsFor(100, 100, GameConfig)).to.equal(3)
		end)
	end)
end
